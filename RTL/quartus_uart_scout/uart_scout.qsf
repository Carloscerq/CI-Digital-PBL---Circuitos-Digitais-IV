set_location_assignment PIN_N21 -to GPIO_0[10]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to GPIO_0[10]
# beacon "N21"
set_instance_assignment -name CURRENT_STRENGTH_NEW "4MA" -to GPIO_0[10]
set_location_assignment PIN_R22 -to GPIO_0[11]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to GPIO_0[11]
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to GPIO_0[11]
