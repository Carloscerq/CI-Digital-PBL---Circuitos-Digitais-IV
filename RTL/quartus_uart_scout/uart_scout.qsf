# ------------------------------------------------------------------ GPIO_1
# All listening, all pulled up.
set_location_assignment PIN_H16 -to GPIO_1[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to GPIO_1[0]
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to GPIO_1[0]
